# Copia este archivo como .env solo si tu herramienta carga variables de entorno.
# Django lee las variables directamente del sistema.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
